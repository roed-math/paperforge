<publication>
    <source>
        <directories external="../assets" generated="../generated-assets"/>
        <!-- The arXiv PDF ships the default detail tier plus PDF-only
             content: detail elaborations and background knowls (components
             "details"/"background") stay HTML-only, while the notation
             index (component "print") appears only here and in print. -->
        <version include="print"/>
    </source>
    <common>
        <journal name="ams"/>
    </common>
</publication>
